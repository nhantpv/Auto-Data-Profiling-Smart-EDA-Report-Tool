# Smart EDA local configuration
#
# Copy this file to .env for local runs. Do not commit .env because it may
# contain API keys or environment-specific settings.

# L4 narrative mode:
# - deterministic: no external LLM call, stable fallback report
# - openai: call OpenAI for Analyst/Editor narrative, then guardrail-check output
SMART_EDA_L4_PROVIDER=openai

# Required only when SMART_EDA_L4_PROVIDER=openai.
OPENAI_API_KEY=

# L4 OpenAI transport. Default code path uses Chat Completions.
SMART_EDA_L4_API_MODE=chat_completions
SMART_EDA_L4_ANALYST_MODEL=gpt-4o-mini
SMART_EDA_L4_EDITOR_MODEL=gpt-4o

# Cross-table planner mode. Keep deterministic for MVP unless explicitly testing L3b LLM.
SMART_EDA_L3B_PROVIDER=openai
SMART_EDA_L3B_MODEL=gpt-4o-mini

# Local web app limits.
SMART_EDA_MAX_UPLOAD_MB=300
SMART_EDA_MAX_MULTI_FILES=10
SMART_EDA_JOB_WORKERS=2

# Guardrail toggle
# Set to 'false' to bypass strict LLM hallucination checks
SMART_EDA_ENABLE_GUARDRAIL=false
